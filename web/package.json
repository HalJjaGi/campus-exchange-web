{
  "name": "campus-exchange-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.20",
    "decimal.js-light": "2.5.1",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "msw": "2.6.4",
    "prettier": "^3.3.3",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
